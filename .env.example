# SQLAlchemy connection string. Defaults to a local SQLite file for dev.
# For Postgres (e.g. via `docker compose --profile postgres up`):
#   DATABASE_URL=postgresql://attrition:attrition@localhost:5432/attrition
DATABASE_URL=sqlite:///./attrition.db

# Directory the trained model bundle and drift baseline are read from/written to.
MODEL_DIR=models
